# Copy to backend/.env, chmod 600; never source this file as shell code.
# This is a TEST environment only. No migration is automatically applied.
ASTROGATEWAY_ENVIRONMENT=test
ASTROGATEWAY_APPROVED_PROJECT_REF=
# Supply the same approved project used by Android. All three required values together.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY: percent-encode the runtime password in the URI; quote the entire value.
# Shared pooler example: postgresql://astrogateway_runtime.PROJECT_REF:ENCODED_PASSWORD@DASHBOARD_POOLER_HOST:5432/postgres
# Direct example: postgresql://astrogateway_runtime:ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# Use the actual dashboard endpoint and dedicated restricted login, NOT postgres/service_role.
DATABASE_URL=
# Usually leave blank. Same-project custom issuer needs review before overriding.
SUPABASE_JWT_ISSUER=
# Native Android does not require CORS. Leave blank for this local test.
CORS_ALLOWED_ORIGINS=
