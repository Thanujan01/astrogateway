(version 1)
(deny default)
(allow process-fork)
(allow process-exec)
(allow sysctl-read)
(allow file-read-metadata)
(allow file-read* (subpath "/opt/homebrew/Cellar/python@3.14"))
(allow file-read* (subpath "/opt/homebrew/opt/python@3.14"))
(allow file-read* (subpath "/System"))
(allow file-read* (subpath "/usr"))
(allow file-read* (subpath "/Library/Apple"))
(allow file-read* (subpath "/private/var/db/dyld"))
(allow file-read* (subpath "/dev/null"))
(allow file-read* (subpath "/dev/urandom"))
(allow file-read* (subpath "/dev/random"))
(allow file-read* (subpath "/Users/kapilash/Documents/Codex/2026-10-08/task-01-create-unity-6-urp/work/stage05b/venv"))
(allow file-read* (subpath "/Users/kapilash/Documents/Codex/2026-10-08/task-01-create-unity-6-urp/work/stage05b3/runtime"))
(allow file-read* (subpath "/Users/kapilash/Documents/Codex/2026-10-08/task-01-create-unity-6-urp/work/stage05b3/scratch"))
(allow file-read* (subpath "/opt/homebrew/Cellar/python@3.14/3.14.7/Frameworks/Python.framework/Versions/3.14"))
(allow file-read* (subpath "/opt/homebrew/Cellar/openssl@3"))
(allow file-read* (subpath "/opt/homebrew/opt/openssl@3"))
(allow file-read* (subpath "/opt/homebrew/lib"))
(allow file-read* (require-not (require-any (subpath "/Users") (subpath "/Volumes") (subpath "/private/tmp") (subpath "/private/var/folders") (subpath "/Library/Keychains"))))
(allow mach-lookup (global-name "com.apple.system.notification_center"))
(allow file-write* (subpath "/Users/kapilash/Documents/Codex/2026-10-08/task-01-create-unity-6-urp/work/stage05b3/scratch"))
(allow file-write-data (literal "/dev/null"))
(allow network-outbound (remote tcp "localhost:51038"))
(allow network-bind (local tcp "localhost:8001"))
(allow network-inbound (local tcp "localhost:8001"))
