SUPABASE_URL=https://YOUR-EXISTING-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# SERVER ONLY: dedicated non-owner LOGIN role; never put this DSN in Android configuration.
DATABASE_URL=postgresql://RUNTIME_LOGIN:SERVER_ONLY_PASSWORD@YOUR_POOLER_HOST:6543/postgres
# Usually empty. Override only for a reviewed custom-domain issuer belonging to the SAME project.
SUPABASE_JWT_ISSUER=
CORS_ALLOWED_ORIGINS=
