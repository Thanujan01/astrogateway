  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "mission_session_id": {
      "format": "uuid",
      "title": "Mission Session Id",
      "type": "string"
    },
    "events": {
      "items": {
        "discriminator": {
          "mapping": {
            "completion": "#/$defs/Completion",
            "emergency": "#/$defs/Emergency",
            "equipment": "#/$defs/Equipment",
            "mistake": "#/$defs/Mistake",
            "movement": "#/$defs/Movement",
            "reaction": "#/$defs/Reaction",
            "resource": "#/$defs/Resource"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/Movement"
          },
          {
            "$ref": "#/$defs/Reaction"
          },
          {
            "$ref": "#/$defs/Resource"
          },
          {
            "$ref": "#/$defs/Equipment"
          },
          {
            "$ref": "#/$defs/Emergency"
          },
          {
            "$ref": "#/$defs/Mistake"
          },
          {
            "$ref": "#/$defs/Completion"
          }
        ]
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Events",
      "type": "array"
    }
  },
  "required": [
    "mission_session_id",
    "events"
  ],
  "title": "Batch",
  "type": "object"
}